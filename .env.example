# Copy this file to .env and fill in what you have. Every value below has
# a sensible default in docker-compose.yml, so `docker compose up` works
# with nothing set - the app runs in rules-only mode with no AI key.

# --- AI provider ---
# LLM_PROVIDER: anthropic | openai | none | auto (default: auto - picks
# whichever key below is set, or rules-only if neither is)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Auth ---
# Set your own JWT_SECRET before sharing this deployment with anyone.
JWT_SECRET=refund-desk-demo-secret-change-me
JWT_TTL=2h
AGENT_EMAIL=agent@example.com
AGENT_PASSWORD=refund-desk-demo

# --- Ports (host side) ---
API_PORT=3000
WEB_PORT=8080

# --- Logging ---
LOG_LEVEL=info
